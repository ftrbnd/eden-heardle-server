{
  "name": "eden-heardle",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start:client": "turbo run start --filter=eden-heardle-client...",
    "start:server": "turbo run start --filter=eden-heardle-server...",
    "build:client": "turbo run db:generate && turbo run build --filter=eden-heardle-client...",
    "build:server": "turbo run db:generate && turbo run build --filter=eden-heardle-server...",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:deploy": "turbo run db:deploy"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.3.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
